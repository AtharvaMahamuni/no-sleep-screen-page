---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import AmbientCanvas from '../components/AmbientCanvas.astro';
import HeroWakeControl from '../components/HeroWakeControl.astro';
import ControlsBar from '../components/ControlsBar.astro';
import SoundMixerModal from '../components/SoundMixerModal.astro';
import TimerModal from '../components/TimerModal.astro';
import QuickAnswers from '../components/QuickAnswers.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { useTranslations } from '../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://nosleeppage.com/#website',
      'url': 'https://nosleeppage.com/',
      'name': 'NoSleep',
      'description': t('site.description'),
      'inLanguage': 'en-US',
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://nosleeppage.com/#webapp',
      'url': 'https://nosleeppage.com/',
      'name': 'NoSleep Screen Wake & Ambient Space',
      'applicationCategory': 'UtilitiesApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires JavaScript and Screen Wake Lock API support',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'author': {
        '@type': 'Person',
        'name': 'Atharva Mahamuni',
        'url': 'https://twitter.com/athmatwt',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://nosleeppage.com/#faq',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'How do I keep my screen on without installing software?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'You can keep your screen on by opening NoSleep (https://nosleeppage.com) in any modern web browser and tapping Keep Screen Awake. NoSleep activates the standard W3C Screen Wake Lock API, signaling to Windows, macOS, ChromeOS, iOS, or Android that the display must remain illuminated, with zero executable downloads or admin privileges required.',
          },
        },
        {
          '@type': 'Question',
          'name': 'What is a "no screen off" online tool and how does it prevent sleep?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'A "no screen off" tool is a browser-based utility that overrides system lock timers and sleep timeouts. Unlike old software utilities like Caffeine or Amphetamine, a modern web-based screen wake tool runs 100% inside your browser sandbox, requiring zero installations, zero registry modifications, and zero corporate IT security permissions.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Can I keep my screen awake on a work computer without admin rights?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Yes. Because NoSleep is a client-side web application using native web standards, it operates entirely within your browser (Chrome, Edge, Safari, Firefox). You do not need administrator privileges, PowerShell scripts, or third-party executable software.',
          },
        },
        {
          '@type': 'Question',
          'name': 'How do I stop my computer screen from turning off on Windows and Mac?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Simply navigate to NoSleep, click "Keep Screen Awake", and leave the tab open in your browser. As long as the browser tab is open, your monitor will not sleep, dim, or trigger the lock screen.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Does keeping the screen awake in the browser drain battery?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Keeping the display backlight illuminated naturally consumes power, but NoSleep uses zero video decoding, lightweight Canvas 2D animations, and pauses all rendering when hidden, consuming up to 95% less CPU and battery than streaming a 10-hour YouTube black screen video.',
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={t('site.title')}
  description={t('site.description')}
  locale={locale}
  canonicalPath="/"
>
  <JsonLd slot="head" schema={jsonLdSchema} />

  <!-- Ambient Application Viewport -->
  <main class="ambient-app-container">
    <Header locale={locale} />
    <AmbientCanvas />
    <HeroWakeControl locale={locale} />
    <ControlsBar locale={locale} />
    <SoundMixerModal locale={locale} />
    <TimerModal locale={locale} />
  </main>

  <!-- User Intent, Guides & FAQ Section -->
  <QuickAnswers locale={locale} />

  <Footer locale={locale} />
</BaseLayout>
