---
import BaseLayout from '../../components/BaseLayout.astro';
import Header from '../../components/Header.astro';
import AmbientCanvas from '../../components/AmbientCanvas.astro';
import HeroWakeControl from '../../components/HeroWakeControl.astro';
import ControlsBar from '../../components/ControlsBar.astro';
import SoundMixerModal from '../../components/SoundMixerModal.astro';
import TimerModal from '../../components/TimerModal.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'Aesthetic Pomodoro Timer with Ambient Sounds — NoSleep',
  'url': 'https://nosleeppage.com/focus/pomodoro/',
  'description': 'Drift-free Pomodoro study timer with ambient sound mixer and screen wake lock.',
  'applicationCategory': 'ProductivityApplication',
};
---

<BaseLayout
  title="Aesthetic Pomodoro Timer with Ambient Sounds — NoSleep"
  description="Boost productivity with a drift-free Pomodoro timer paired with calming ambient soundscapes and screen wake lock. Free, private, and distraction-free."
  canonicalPath="/focus/pomodoro/"
>
  <JsonLd slot="head" schema={jsonLd} />

  <main class="ambient-app-container">
    <Header locale="en" />
    <AmbientCanvas />
    <HeroWakeControl locale="en" />
    <ControlsBar locale="en" />
    <SoundMixerModal locale="en" />
    <TimerModal locale="en" />
  </main>

  <article class="content-container">
    <h1>Aesthetic Pomodoro Timer with Ambient Audio & Screen Lock</h1>
    <p class="lead">
      Supercharge your productivity without ticking sounds or jarring alarms. NoSleep's Pomodoro timer pairs
      scientific 25-minute intervals with customized ambient soundscapes and a continuous screen wake lock.
    </p>

    <section class="info-block">
      <h2>The Pomodoro Technique Explained</h2>
      <p>
        Developed by Francesco Cirillo in the late 1980s, the technique utilizes 25-minute periods of uninterrupted work
        separated by 5-minute rest breaks. After four cycles, a longer 15–30 minute break is taken to prevent cognitive fatigue.
      </p>
    </section>

    <section class="info-block">
      <h2>Drift-Free Precision</h2>
      <p>
        Traditional browser timers can drift when your computer enters power-saving sleep modes. NoSleep computes elapsed
        time strictly against high-resolution system timestamps, ensuring your 25-minute sprint is accurate down to the millisecond.
      </p>
    </section>
  </article>

  <Footer locale="en" />
</BaseLayout>

<style>
  .content-container {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info-block h2 {
    font-size: 1.35rem;
  }

  .info-block p {
    line-height: 1.65;
  }
</style>
