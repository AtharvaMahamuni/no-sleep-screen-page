---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const audioAssets = [
  {
    name: 'Gentle Rooftop Rain',
    type: 'Procedural Web Audio + Nature Filter',
    author: 'NoSleep Synthesis Lab',
    license: 'Creative Commons Zero (CC0 / Public Domain)',
    attribution: 'Synthesized mathematical pink noise curve with lowpass filtering.'
  },
  {
    name: 'Warm Brown Noise Spectrum',
    type: 'Procedural Web Audio Generator',
    author: 'NoSleep Synthesis Lab',
    license: 'Creative Commons Zero (CC0 / Public Domain)',
    attribution: 'Continuous random-walk Brownian acoustic synthesis (-6 dB/octave).'
  },
  {
    name: 'Rolling Ocean Waves',
    type: 'Procedural LFO Swell Synthesis',
    author: 'NoSleep Synthesis Lab',
    license: 'Creative Commons Zero (CC0 / Public Domain)',
    attribution: 'Slow 0.12 Hz resonant lowpass filter modulation.'
  },
  {
    name: 'Morning Forest Birds',
    type: 'Nature Atmosphere Synthesis',
    author: 'NoSleep Synthesis Lab',
    license: 'Creative Commons Zero (CC0 / Public Domain)',
    attribution: 'Resonant bandpass filtered nature ambience.'
  },
  {
    name: 'Velvet Midnight Lo-Fi Rhodes',
    type: 'Harmonic Chord Oscillator Progression',
    author: 'Atharva Mahamuni',
    license: 'Creative Commons Zero (CC0 / Public Domain)',
    attribution: 'Original 4-chord electronic piano composition.'
  }
];
---

<BaseLayout
  title="Audio Licensing Credits & Attributions — NoSleep"
  description="Verified open licensing and procedural sound synthesis attributions for NoSleep's ambient audio library."
  canonicalPath="/audio-credits/"
>
  <Header locale="en" />

  <main class="page-container">
    <h1>Audio Licensing & Credits</h1>
    <p class="subtitle">Complete transparency and legal attribution for all soundscapes in NoSleep.</p>

    <div class="credits-grid">
      {audioAssets.map((asset) => (
        <div class="credit-card glass-surface">
          <h3>{asset.name}</h3>
          <p class="credit-type mono">{asset.type}</p>
          <div class="meta-row">
            <strong>Author:</strong> <span>{asset.author}</span>
          </div>
          <div class="meta-row">
            <strong>License:</strong> <span>{asset.license}</span>
          </div>
          <p class="attribution-note">{asset.attribution}</p>
        </div>
      ))}
    </div>
  </main>

  <Footer locale="en" />
</BaseLayout>

<style>
  .page-container {
    max-width: 820px;
    margin: 0 auto;
    padding: calc(var(--space-16) + 40px) var(--space-4) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .credits-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .credit-card {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .credit-card h3 {
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .credit-type {
    font-size: 0.8rem;
    color: var(--color-primary);
  }

  .meta-row {
    font-size: 0.88rem;
    color: var(--color-body);
    display: flex;
    gap: var(--space-2);
  }

  .attribution-note {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: var(--space-1);
    line-height: 1.4;
  }
</style>
