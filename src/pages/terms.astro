---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Terms of Use — NoSleep"
  description="Terms and conditions for using NoSleep, an open web utility for screen wake lock and ambient sounds."
  canonicalPath="/terms/"
>
  <Header locale="en" />

  <main class="page-container">
    <h1>Terms of Use</h1>
    <p class="effective-date">Last Updated: November 2026</p>

    <section class="section">
      <h2>1. Acceptance of Terms</h2>
      <p>
        By accessing and using NoSleep (nosleeppage.com), you agree to these Terms of Use. The service is provided
        free of charge as a static web utility.
      </p>
    </section>

    <section class="section">
      <h2>2. Disclaimer of Warranties</h2>
      <p>
        NoSleep is provided "as is" and "as available" without warranties of any kind. While we strive for 100%
        reliability, browser power-saving mechanisms, operating system policies, and battery limitations may cause
        the display to sleep in certain hardware conditions.
      </p>
    </section>

    <section class="section">
      <h2>3. Intellectual Property</h2>
      <p>
        Application code is licensed under the MIT License. Ambient audio synthesis models and procedural soundscapes
        are free for personal and commercial listening.
      </p>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>

<style>
  .page-container {
    max-width: 760px;
    margin: 0 auto;
    padding: calc(var(--space-16) + 40px) var(--space-4) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .effective-date {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .section h2 {
    font-size: 1.25rem;
  }

  .section p {
    color: var(--color-body);
    line-height: 1.65;
  }
</style>
