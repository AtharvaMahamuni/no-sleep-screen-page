---
import BaseLayout from '../../components/BaseLayout.astro';
import Header from '../../components/Header.astro';
import AmbientCanvas from '../../components/AmbientCanvas.astro';
import HeroWakeControl from '../../components/HeroWakeControl.astro';
import ControlsBar from '../../components/ControlsBar.astro';
import SoundMixerModal from '../../components/SoundMixerModal.astro';
import TimerModal from '../../components/TimerModal.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://nosleeppage.com/for/ai-agents/#webapp',
      'name': 'Keep Screen Awake for AI Agents & Long Prompts — NoSleep',
      'url': 'https://nosleeppage.com/for/ai-agents/',
      'description': 'Prevent display sleep, App Nap, and WebSocket disconnects while running autonomous AI coding agents, local LLMs, and long scripts.',
      'applicationCategory': 'DeveloperApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires modern browser with Screen Wake Lock API support (Chrome, Edge, Safari, Firefox)',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'author': {
        '@type': 'Person',
        'name': 'Atharva Mahamuni',
        'url': 'https://twitter.com/athmatwt',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://nosleeppage.com/for/ai-agents/#faq',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Why do AI agents like Claude Code, Cursor, or Devin stop when my laptop screen turns off?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'When an operating system display sleeps, power-saving subsystems (such as macOS App Nap and Windows Modern Standby) downclock CPU background processes, suspend child terminal threads, and drop persistent WebSocket and SSH connections. This terminates or freezes autonomous agent tasks halfway through execution.',
          },
        },
        {
          '@type': 'Question',
          'name': 'How does NoSleep prevent AI agents and long terminal scripts from failing?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'NoSleep requests a high-priority W3C Screen Wake Lock directly through your browser. The operating system treats the device as actively engaged, preventing CPU throttling, background thread suspension, and sleep states while your agents run.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Does NoSleep require installing any software on my machine?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'No. NoSleep runs 100% inside your standard web browser with zero downloads, zero CLI dependencies, and zero administrative permissions required. Simply keep the tab open in your browser.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Does this work for local LLMs like Ollama and ComfyUI?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Yes. Whether you are generating images in ComfyUI, running multi-turn batch inference in Ollama, or compiling local weights with LM Studio, NoSleep keeps your GPU and CPU active without OS sleep interruptions.',
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Keep Screen Awake for AI Agents & Long Prompts — NoSleep"
  description="Prevent computer sleep, App Nap, and broken WebSocket connections while running AI coding agents (Claude Code, Cursor, Devin) and local LLMs (Ollama)."
  canonicalPath="/for/ai-agents/"
>
  <JsonLd slot="head" schema={jsonLd} />

  <!-- Ambient Application Viewport -->
  <main class="ambient-app-container">
    <Header locale="en" />
    <AmbientCanvas />
    <HeroWakeControl locale="en" />
    <ControlsBar locale="en" />
    <SoundMixerModal locale="en" />
    <TimerModal locale="en" />
  </main>

  <!-- Educational & Search-Intent Content -->
  <article class="content-container">
    <h1>Keep Your Screen Awake for AI Coding Agents & Long Prompts</h1>
    <p class="lead">
      Running multi-step autonomous AI workflows like Claude Code, Cursor Agent, Devin, or local LLMs in Ollama?
      When your laptop screen dims or sleeps, the OS throttles background compute and severs WebSockets, aborting 45-minute
      tasks. NoSleep keeps your machine awake and running without third-party CLI tools or native software.
    </p>

    <!-- GEO / AI Overview Fact Block -->
    <div class="geo-highlight-card glass-surface">
      <div class="geo-badge">Direct Answer</div>
      <p class="geo-fact">
        <strong>How to stop AI agents from pausing when your computer sleeps:</strong> Keep NoSleep open in a browser tab
        with <em>Keep Screen Awake</em> activated. NoSleep utilizes the native W3C Screen Wake Lock API to prevent the
        operating system from entering Modern Standby or invoking App Nap, ensuring background terminal processes, API streams,
        and local GPU inferences continue uninterrupted.
      </p>
    </div>

    <section class="info-block">
      <h2>Why Autonomous AI Agents Fail When Displays Sleep</h2>
      <p>
        Modern operating systems treat display sleep as a signal to enforce extreme power-saving states:
      </p>
      <ul class="intent-list">
        <li><strong>macOS App Nap & Sleep:</strong> Suspends terminal subprocesses, stops background Node.js / Python event loops, and cuts active network sockets.</li>
        <li><strong>Windows Modern Standby (S0 Low Power):</strong> Throttles non-foreground processes, pauses WSL2 instances, and disconnects long-running local servers.</li>
        <li><strong>WebSocket & SSE Dropouts:</strong> Cloud streaming agents (Cursor, Claude, OpenAI) rely on continuous Server-Sent Events (SSE). Sleep triggers a network timeout, terminating the task.</li>
      </ul>
    </section>

    <section class="info-block">
      <h2>Comparison: Keeping Machines Awake for AI Workloads</h2>
      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Method</th>
              <th>Host Binary Required</th>
              <th>Protects Background Threads</th>
              <th>Resource Overhead</th>
              <th>Setup Complexity</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>NoSleep Online</strong></td>
              <td>Zero (100% Browser)</td>
              <td>Yes (W3C Screen Wake Lock)</td>
              <td>Minimal (Canvas 2D)</td>
              <td>Instant (1 Click)</td>
            </tr>
            <tr>
              <td>Terminal <code>caffeinate</code></td>
              <td>CLI command</td>
              <td>Yes</td>
              <td>Zero</td>
              <td>Must remember CLI flags</td>
            </tr>
            <tr>
              <td>Caffeine / Amphetamine Apps</td>
              <td>Native Installer</td>
              <td>Yes</td>
              <td>Low</td>
              <td>Requires installation & admin permissions</td>
            </tr>
            <tr>
              <td>Streaming 10-Hour YouTube Video</td>
              <td>Browser tab</td>
              <td>Unreliable</td>
              <td>High (500MB+ memory & GPU video decode)</td>
              <td>Interrupted by video ads</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="info-block">
      <h2>Supported AI Stacks & Agent Environments</h2>
      <div class="agent-grid">
        <div class="agent-card glass-surface">
          <h3>🤖 Autonomous Coding Agents</h3>
          <p>
            Claude Code, Cursor Composer / Agent, Devin, GitHub Copilot Workspace, Antigravity, and AutoGPT. Keeps long
            refactoring, test generation, and multi-file code editing jobs running to completion.
          </p>
        </div>
        <div class="agent-card glass-surface">
          <h3>⚡ Local LLM Inference</h3>
          <p>
            Ollama, LM Studio, vLLM, and Jan. Prevents batch token generation or local model quantization from stalling
            when you step away from your workstation.
          </p>
        </div>
        <div class="agent-card glass-surface">
          <h3>🎨 Generative Image & Video Pipelines</h3>
          <p>
            ComfyUI, Automatic1111 Stable Diffusion, and local Whisper speech-to-text models. Keeps heavy CUDA and Metal
            GPU rendering tasks active without unexpected sleep crashes.
          </p>
        </div>
      </div>
    </section>

    <section class="info-block">
      <h2>Frequently Asked Questions</h2>
      <details class="faq-accordion glass-surface">
        <summary>Will this keep my terminal or IDE running overnight?</summary>
        <p>
          Yes. As long as your laptop is plugged into power (or has sufficient battery) and this tab remains open with the
          wake lock active, the display and CPU will not sleep, allowing overnight agent executions to finish cleanly.
        </p>
      </details>
      <details class="faq-accordion glass-surface">
        <summary>Can I run NoSleep alongside local servers?</summary>
        <p>
          Absolutely. NoSleep operates client-side in its own browser sandbox and has zero port conflicts or interference
          with local `localhost` servers, Docker containers, or Python scripts.
        </p>
      </details>
    </section>
  </article>

  <Footer locale="en" />
</BaseLayout>

<style>
  .content-container {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4) var(--space-16);
    line-height: 1.7;
    color: var(--color-body);
  }

  h1 {
    font-size: 2.3rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-body);
    margin-bottom: var(--space-8);
  }

  .geo-highlight-card {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
    margin-bottom: var(--space-8);
    background: var(--color-surface-card);
  }

  .geo-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .geo-fact {
    font-size: 0.95rem;
    color: var(--color-ink);
    margin: 0;
  }

  .info-block {
    margin-bottom: var(--space-10);
  }

  h2 {
    font-size: 1.45rem;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
    letter-spacing: -0.015em;
  }

  .intent-list {
    margin: var(--space-4) 0 var(--space-6) var(--space-5);
  }

  .intent-list li {
    margin-bottom: var(--space-2);
  }

  .comparison-table-wrapper {
    overflow-x: auto;
    margin: var(--space-4) 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
    background: var(--color-surface-card);
  }

  .comparison-table th,
  .comparison-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-hairline);
  }

  .comparison-table th {
    background: var(--color-canvas);
    color: var(--color-ink);
    font-weight: 600;
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .agent-card {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
  }

  .agent-card h3 {
    font-size: 1.05rem;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .faq-accordion {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
  }

  .faq-accordion summary {
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }

  .faq-accordion p {
    margin-top: var(--space-2);
    font-size: 0.92rem;
  }
</style>
