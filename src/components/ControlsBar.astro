---
import type { SupportedLocale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="controls-bar-wrapper">
  <!-- Presets Pill Bar (With clear label) -->
  <div class="preset-pills-bar glass-surface" role="radiogroup" aria-label="Atmosphere Presets">
    <div class="preset-label-tag">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      </svg>
      <span>{t('controls.atmosphere')}</span>
    </div>

    <div class="preset-buttons">
      <button class="preset-pill active" data-preset-id="rainy-evening" role="radio" aria-checked="true" aria-label="Rainy Evening Preset">
        <span class="preset-emoji">🌧️</span>
        <span>{t('preset.rainy')}</span>
      </button>
      <button class="preset-pill" data-preset-id="deep-focus" role="radio" aria-checked="false" aria-label="Deep Focus Preset">
        <span class="preset-emoji">☕</span>
        <span>{t('preset.deepFocus')}</span>
      </button>
      <button class="preset-pill" data-preset-id="ocean-calm" role="radio" aria-checked="false" aria-label="Ocean Calm Preset">
        <span class="preset-emoji">🌊</span>
        <span>{t('preset.oceanCalm')}</span>
      </button>
    </div>
  </div>

  <!-- Primary Floating Action Controls Dock -->
  <div class="controls-dock glass-surface" role="toolbar" aria-label="Application Controls">
    <!-- Sound Section -->
    <div class="dock-cluster sound-cluster">
      <button id="audio-play-pause-btn" class="dock-btn primary-dock-btn" aria-label={t('sound.play')}>
        <svg class="play-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg class="pause-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
        <span id="audio-btn-label">{t('controls.playSounds')}</span>
      </button>

      <button id="open-mixer-btn" class="dock-btn" aria-label={t('sound.mixer')} title="Adjust Rain, Ocean, Noise & Melody volumes">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <circle cx="4" cy="12" r="2"></circle>
          <circle cx="12" cy="10" r="2"></circle>
          <circle cx="20" cy="14" r="2"></circle>
        </svg>
        <span>{t('controls.mixer')}</span>
        <span class="dock-badge">5</span>
      </button>
    </div>

    <div class="dock-divider"></div>

    <!-- Timer Section -->
    <div class="dock-cluster timer-cluster" role="group" aria-label="Timer">
      <div class="timer-display-group">
        <span class="timer-tag">{t('controls.timerLabel')}</span>
        <span id="timer-display" class="timer-digits mono">25:00</span>
      </div>

      <div class="timer-actions">
        <button id="timer-start-pause-btn" class="timer-btn primary" aria-label="Start or Pause Timer">
          {t('timer.start')}
        </button>
        <button id="timer-reset-btn" class="timer-btn secondary" aria-label="Reset Timer" title="Reset to initial interval">
          {t('timer.reset')}
        </button>
        <button id="open-timer-modal-btn" class="timer-btn options" aria-label="Timer Mode Options" title="Select Pomodoro (25m), Break (5m), or Sleep Timer">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>{t('controls.timerModes')}</span>
        </button>
      </div>
    </div>

    <div class="dock-divider"></div>

    <!-- Utility & View Actions -->
    <div class="dock-cluster tools-cluster">
      <button id="fullscreen-toggle-btn" class="icon-dock-btn" aria-label={t('ui.fullscreen')} title="Toggle Fullscreen View">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
        <span class="tool-label">{t('ui.fullscreen')}</span>
      </button>

      <button id="pip-toggle-btn" class="icon-dock-btn" aria-label={t('ui.pip')} title="Floating Mini Player Window">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <rect x="11" y="9" width="9" height="6" rx="1"></rect>
        </svg>
        <span class="tool-label">{t('ui.pip')}</span>
      </button>

      <button id="share-preset-btn" class="icon-dock-btn" aria-label={t('ui.share')} title="Copy link to your current scene and sound setup">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span class="tool-label" id="share-btn-text">{t('ui.share')}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .controls-bar-wrapper {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2-5, 10px);
    z-index: 50;
    width: max-content;
    max-width: calc(100vw - var(--space-4));
    pointer-events: none;
  }

  .preset-pills-bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-subtle);
  }

  .preset-label-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-body);
  }

  .preset-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .preset-pill {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-body);
    gap: 6px;
    background: transparent;
    transition: all var(--duration-fast) var(--ease-out-quint);
  }

  .preset-pill:hover {
    color: var(--color-ink);
    background: var(--color-hairline-soft);
  }

  .preset-pill.active {
    background: var(--color-ink);
    color: #ffffff;
    border: 1px solid var(--color-primary);
    font-weight: 600;
  }

  .preset-emoji {
    font-size: 0.95rem;
    line-height: 1;
  }

  .controls-dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-floating);
    background: var(--color-surface-glass);
    border: 1px solid var(--color-hairline);
    backdrop-filter: blur(16px);
  }

  .dock-cluster {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dock-divider {
    width: 1px;
    height: 24px;
    background: var(--color-hairline);
  }

  .dock-btn {
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-ink);
    gap: var(--space-2);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    transition: all var(--duration-fast) var(--ease-out-quint);
  }

  .dock-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-surface-card);
  }

  .primary-dock-btn {
    background: var(--color-canvas);
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
    font-weight: 600;
  }

  .primary-dock-btn.playing {
    background: var(--color-ink);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .dock-badge {
    padding: 1px 6px;
    border-radius: var(--radius-full);
    background: var(--color-hairline);
    color: var(--color-ink);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  /* Timer Cluster */
  .timer-cluster {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .timer-display-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 var(--space-1);
  }

  .timer-tag {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-body);
    line-height: 1;
  }

  .timer-digits {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .timer-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .timer-btn {
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    gap: 4px;
    transition: all var(--duration-fast) var(--ease-out-quint);
  }

  .timer-btn:hover {
    border-color: var(--color-hairline-strong);
    background: var(--color-surface-card);
  }

  .timer-btn.primary {
    background: var(--color-ink);
    color: #ffffff;
    border-color: var(--color-ink);
    font-weight: 600;
  }

  .timer-btn.primary:hover {
    background: var(--color-ink);
    border-color: var(--color-primary);
    color: #ffffff;
  }

  .timer-btn.options {
    color: var(--color-body);
    font-weight: 500;
  }

  .timer-btn.options:hover {
    color: var(--color-ink);
  }

  /* Tools Cluster */
  .tools-cluster {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .icon-dock-btn {
    padding: 6px 10px;
    border-radius: var(--radius-full);
    color: var(--color-body);
    font-size: 0.8rem;
    font-weight: 500;
    gap: 6px;
    background: transparent;
    transition: all var(--duration-fast) var(--ease-out-quint);
  }

  .icon-dock-btn:hover {
    color: var(--color-ink);
    background: var(--color-canvas);
  }

  @media (max-width: 900px) {
    .tool-label {
      display: none;
    }

    .icon-dock-btn {
      padding: 6px 8px;
    }
  }

  @media (max-width: 640px) {
    .controls-bar-wrapper {
      bottom: var(--space-3);
      width: calc(100vw - var(--space-4));
    }

    .preset-pills-bar {
      width: 100%;
      justify-content: center;
      overflow-x: auto;
    }

    .controls-dock {
      width: 100%;
      justify-content: space-between;
      padding: var(--space-2);
      gap: var(--space-1-5);
    }

    .dock-btn span {
      display: none;
    }

    .timer-tag {
      display: none;
    }

    .timer-btn.options span {
      display: none;
    }
  }
</style>
