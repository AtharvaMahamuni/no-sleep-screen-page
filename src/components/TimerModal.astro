---
import type { SupportedLocale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div id="timer-modal" class="timer-modal-backdrop" aria-hidden="true">
  <div class="timer-sheet glass-surface" role="dialog" aria-labelledby="timer-modal-title">
    <div class="sheet-header">
      <h2 id="timer-modal-title" class="sheet-title">Timer Modes</h2>
      <button id="close-timer-modal-btn" class="close-btn" aria-label="Close Timer Options">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="modes-section">
      <h3 class="section-label">Focus Intervals</h3>
      <div class="modes-grid">
        <button id="timer-mode-pomodoro" class="mode-pill active">
          <span class="mode-name">Pomodoro</span>
          <span class="mode-time mono">25 min</span>
        </button>
        <button id="timer-mode-break" class="mode-pill">
          <span class="mode-name">Short Break</span>
          <span class="mode-time mono">5 min</span>
        </button>
      </div>
    </div>

    <div class="modes-section">
      <h3 class="section-label">{t('timer.sleep')}</h3>
      <p class="section-desc">Automatically stops audio and allows screen sleep when time expires.</p>
      <div class="sleep-buttons-row">
        <button class="sleep-pill" data-sleep-minutes="15">15m</button>
        <button class="sleep-pill active" data-sleep-minutes="30">30m</button>
        <button class="sleep-pill" data-sleep-minutes="45">45m</button>
        <button class="sleep-pill" data-sleep-minutes="60">60m</button>
      </div>
    </div>
  </div>
</div>

<style>
  .timer-modal-backdrop {
    position: fixed;
    inset: 0;
    background: var(--color-surface-overlay);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .timer-modal-backdrop.open {
    display: flex;
  }

  .timer-sheet {
    width: 340px;
    max-width: calc(100vw - var(--space-6));
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: var(--shadow-modal);
  }

  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sheet-title {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .close-btn {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    color: var(--color-muted);
  }

  .close-btn:hover {
    color: var(--color-ink);
  }

  .modes-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .section-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .section-desc {
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.35;
  }

  .modes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .mode-pill {
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-0-5);
    transition: all var(--duration-fast) var(--ease-out-quint);
  }

  .mode-pill:hover {
    border-color: var(--color-primary);
  }

  .mode-pill.active {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .mode-name {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .mode-time {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .sleep-buttons-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }

  .sleep-pill {
    padding: var(--space-1-5) 0;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-body);
  }

  .sleep-pill:hover,
  .sleep-pill.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }
</style>

<script>
  const timerModal = document.getElementById('timer-modal');
  const openTimerModalBtn = document.getElementById('open-timer-modal-btn');
  const closeTimerModalBtn = document.getElementById('close-timer-modal-btn');

  openTimerModalBtn?.addEventListener('click', () => {
    timerModal?.classList.add('open');
    timerModal?.setAttribute('aria-hidden', 'false');
  });

  closeTimerModalBtn?.addEventListener('click', () => {
    timerModal?.classList.remove('open');
    timerModal?.setAttribute('aria-hidden', 'true');
  });

  timerModal?.addEventListener('click', (e) => {
    if (e.target === timerModal) {
      timerModal.classList.remove('open');
      timerModal.setAttribute('aria-hidden', 'true');
    }
  });

  // Handle sleep timer selection
  const sleepButtons = document.querySelectorAll('[data-sleep-minutes]');
  sleepButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      sleepButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const sleepModeBtn = document.getElementById('timer-mode-sleep');
      if (sleepModeBtn) {
        sleepModeBtn.click();
      }
    });
  });
</script>
